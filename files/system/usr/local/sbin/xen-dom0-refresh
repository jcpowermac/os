#!/usr/bin/bash
# xen-dom0-refresh: keep the hand-rolled GRUB Xen dom0 entry in sync with the
# running ostree deployment. Best-effort — must never fail boot.
#
# Triggered by xen-dom0-refresh.path (new ostree deployment dirs appear under
# /ostree/deploy/fedora/) and xen-dom0-refresh.service (every boot, covers
# updates applied while the machine was off).
#
# Background: Atomic installs never run grub2-install, so GRUB user config
# goes in /boot/grub2/user.cfg (sourced by the static grub.cfg before blscfg,
# making our entry menu item 0 = default). The image build loses the
# xen-hypervisor /boot payloads (the real /boot partition shadows the ostree
# root's /boot), so we restore them from the rpm when missing.
set -uo pipefail

log() { echo "xen-dom0-refresh: $*" >&2; }

# --- 1. restore /boot xen payload if the image build dropped it -------------
# rpm names the payload /boot/xen-<VERSION>.gz (no release suffix)
ver=$(rpm -q --qf '%{VERSION}' xen-hypervisor 2>/dev/null) || exit 0
pkgver=$(rpm -q --qf '%{VERSION}-%{RELEASE}' xen-hypervisor)
if [ ! -f "/boot/xen-${ver}.gz" ]; then
  base="xen-hypervisor-${pkgver}.x86_64.rpm"
  fedora=$(rpm -E %fedora)
  tmp=""
  for url in \
    "https://dl.fedoraproject.org/pub/fedora/linux/updates/${fedora}/Everything/x86_64/Packages/x/${base}" \
    "https://dl.fedoraproject.org/pub/fedora/linux/releases/${fedora}/Everything/x86_64/os/Packages/x/${base}"; do
    tmp=$(mktemp)
    if curl -fsSL --max-time 120 -o "$tmp" "$url" && rpm -qlp "$tmp" >/dev/null 2>&1; then
      break
    fi
    rm -f "$tmp"
    tmp=""
  done
  if [ -n "$tmp" ]; then
    t=$(mktemp -d)
    if (cd "$t" && rpm2cpio "$tmp" | cpio -idm --quiet './boot/*') 2>/dev/null; then
      install -m644 "$t"/boot/xen-*.gz "$t"/boot/xen-*.config /boot/
      install -d -m755 /boot/flask
      install -m644 "$t"/boot/flask/* /boot/flask/ 2>/dev/null || true
      log "restored /boot xen payload for ${ver}"
    fi
    rm -rf "$t" "$tmp"
  else
    log "could not download ${base}"
  fi
fi

# --- 2. GRUB modules (no grub2-install on atomic; module2 lives in multiboot2.mod)
if [ ! -f /boot/grub2/x86_64-efi/multiboot2.mod ] && [ -d /usr/lib/grub/x86_64-efi ]; then
  rm -rf /boot/grub2/x86_64-efi
  cp -a /usr/lib/grub/x86_64-efi /boot/grub2/x86_64-efi
  find /boot/grub2/x86_64-efi -type d -exec chmod 755 {} +
  find /boot/grub2/x86_64-efi -type f -exec chmod 644 {} +
  log "copied grub modules to /boot/grub2/x86_64-efi"
fi

# --- 3. dom0 kernel/initrd hardlinks (GRUB cannot follow symlinks) ----------
kr=$(uname -r)
d=""
for cand in /boot/ostree/*/; do
  if [ -f "${cand}vmlinuz-${kr}" ]; then d=${cand%/}; break; fi
done
if [ -n "$d" ]; then
  mkdir -p /boot/xen-dom0
  ln -f "$d/vmlinuz-${kr}" /boot/xen-dom0/vmlinuz
  ln -f "$d/initramfs-${kr}.img" /boot/xen-dom0/initrd
else
  log "no /boot/ostree kernel dir for $(uname -r); skipping hardlinks"
fi

# --- 4. user.cfg regenerated from the kernel cmdline of the running boot ----
# (ostree=, root=, rd.luks.uuid= ... all carried over verbatim)
ostree_arg=$(sed -n 's/.*\bostree=\([^ ]*\).*/\1/p' /proc/cmdline)
[ -n "$ostree_arg" ] || { log "no ostree= in /proc/cmdline; skipping user.cfg"; exit 0; }
kargs=$(tr ' ' '\n' < /proc/cmdline |
  grep -vE '^(BOOT_IMAGE=|BOOT_DEV=|BOOT_HARDWARE=|BOOT_MODE=|srmod=|rhgb|quiet|console=.*|rd.shell|ro|rw)$' |
  paste -sd' ')
cat > /boot/grub2/user.cfg <<EOF
# Generated by xen-dom0-refresh (xen-dom0-refresh.path/service) — do not edit.
# Sourced by static grub.cfg before blscfg -> menu entry 0 (default).
set timeout=5
menuentry "Fedora (Xen dom0)" --class fedora {
  multiboot2 /xen-${ver}.gz
  module2 /xen-dom0/vmlinuz ${kargs} console=hvc0 console=tty0 rd.shell rw
  module2 /xen-dom0/initrd
}
EOF
log "wrote /boot/grub2/user.cfg (ostree=${ostree_arg})"
